#!/bin/zsh
# clamwaked: keep the Mac awake with the lid closed while the conditions hold (see docs/SPEC.md "Behaviour").
# Runs as root (LaunchDaemon). Sets `pmset -a disablesleep` 1 or 0, and always 0 when it stops.
# --dry-run: decide and log only, never change anything with pmset (runs without root; heat is then unknown).
zmodload zsh/datetime zsh/system
# Without the library nothing can be decided: let the Mac sleep
source ${0:A:h}/clamwake-lib.zsh || { [[ ${1:-} == --dry-run ]] || pmset -a disablesleep 0; exit 1; }

DRY=0
[[ ${1:-} == --dry-run ]] && DRY=1
wait_for=$tick              # seconds until the next look without a line from pslog (set by decide)
# var/clamwake belongs to the user (install.sh makes it), so `clamwake on|off|auto` and `home add` need no sudo;
# it is made here only when missing, as for a dry run from the clone
mkdir -p $VAR ${LOG_FILE:h}

tripped=0                   # heat guard tripped
nominal_since=0             # when the pressure became Nominal while tripped
last_thermal=0; level=""
last_network=0; home=0; home_name=""
was_closed=-1
current=-1                  # disablesleep as we last set it (-1: not yet)
finished=0

pmset_out=""                # what the last pmset printed
pmset_error=""              # the last failure, logged once while it lasts

failed() { [[ $1 == "$pmset_error" ]] || log "$1"; pmset_error=$1; return 1; }

run() {                     # pmset that changes something: logged only in a dry run; 1 when it failed
  (( DRY )) && { log "dry-run: would run pmset $*"; return 0; }
  pmset_out=$(pmset "$@" 2>&1) || failed "pmset $* failed: ${pmset_out:-no message}"
}

set_disablesleep() {        # pmset exits 0 even when it fails (not root), so read SleepDisabled back
  run -a disablesleep $1 || return
  (( DRY )) && return 0
  local now=$(sleep_disabled)
  [[ $now == $1 ]] || { failed "pmset -a disablesleep $1 did not apply (SleepDisabled is $now): ${pmset_out:-no message}"; return; }
  pmset_error=""
}

finish() {
  (( finished )) && return
  finished=1
  if set_disablesleep 0; then log "stopped: disablesleep 0"; else log "stopped, but disablesleep could not be set to 0"; fi
  [[ -n ${PSLOG_PID:-} ]] && kill $PSLOG_PID 2>/dev/null
  exit 0
}
trap finish INT TERM HUP EXIT

check_heat() {
  local now=$1
  (( now - last_thermal >= thermal_check )) || return
  last_thermal=$now
  level=$(thermal_level)
  [[ -n $level ]] || return
  if (( ${LEVEL[$level]:-0} >= ${LEVEL[$thermal_trip]:-2} )); then
    if (( ! tripped )); then
      tripped=1; log "heat: $level, tripped"
      lid_closed && { log "sleep now (heat, lid closed)"; run sleepnow; }
    fi
    nominal_since=0
  elif (( tripped )); then
    if [[ $level == Nominal ]]; then
      (( nominal_since )) || nominal_since=$now
      if (( now - nominal_since >= thermal_clear )); then
        tripped=0; log "heat: Nominal for ${thermal_clear}s, cleared"
      fi
    else
      nominal_since=0
    fi
  fi
}

decide() {                  # $1=1: a line from pmset -g pslog (the power may have changed, or the Mac just woke)
  local now=$EPOCHSECONDS m src pct closed want=0 why
  m=$(mode); src=$(power_source); pct=$(battery_percent)
  if lid_closed; then closed=1; else closed=0; fi

  # The network matters only in auto on AC. Right after a wake it may not be up yet: with no gateway, look again at
  # every tick, not only after network_check, or the Mac falls asleep again before it is seen to be home
  if [[ $m == auto && $src == AC ]] && (( ${1:-0} || now - last_network >= network_check )); then
    if at_home; then home=1; else home=0; fi
    home_name=$REPLY
    [[ -n $(gateway_ip) ]] && last_network=$now
  fi
  # Heat only while awake (or tripped, to see it clear): powermetrics is the heaviest look
  (( current == 1 || tripped )) && check_heat $now

  if [[ $m == off ]]; then why="mode off"
  elif (( tripped )); then why="heat ($level)"
  elif [[ $m == on && $src == Battery ]] && (( ${pct:-0} <= battery_floor )); then why="battery ${pct}% <= ${battery_floor}%"
  elif [[ $m == on ]]; then want=1; why="mode on"
  elif [[ $src != AC ]]; then why="on battery"
  elif (( ! home )); then why="not a home network"
  else want=1; why="AC, home $home_name"
  fi

  # Only what pmset really did counts: after a failure, current stays and the next look tries again
  if (( want != current )) && set_disablesleep $want; then
    log "decision: disablesleep $want ($why; mode $m, $src ${pct}%, lid closed $closed)"
    current=$want
  fi
  # The lid just closed while awake: disablesleep leaves the display lit, so turn it off
  if (( want && closed && was_closed == 0 )); then
    log "lid closed: display off"; run displaysleepnow
  fi
  was_closed=$closed
  # On battery in auto, or in off, only the power (a line from pslog) and the mode file can change the decision:
  # look less often to spare the battery
  if [[ $m == on || ( $m == auto && $src == AC ) ]]; then wait_for=$tick; else wait_for=$idle_tick; fi

  print -r -- "time=$now mode=$m decision=$want reason=$why power=$src battery=$pct home=$home home_name=$home_name heat=${level:-unknown} tripped=$tripped lid_closed=$closed dry_run=$DRY pid=$$" > $STATE_FILE.tmp &&
    mv $STATE_FILE.tmp $STATE_FILE
}

if (( DRY )); then log "started (dry run) pid $$"; else log "started pid $$"; fi

# Power changes come as output from `pmset -g pslog` (not every line is a change, so any output only means "look
# again"); without output, look again after tick (or idle_tick) seconds for the lid, the mode file, the network and
# the heat. sysread, not read -t: pslog's lines reach the pipe in pieces, and read -t then waits for the rest of the
# line instead of timing out
while true; do
  coproc pmset -g pslog
  PSLOG_PID=$!
  exec {pslog}<&p
  while true; do
    sysread -i $pslog -t $wait_for -s 4096 chunk
    case $? in
      0) decide 1;;
      4) decide;;           # timed out
      *) break;;            # pslog ended
    esac
  done
  exec {pslog}<&-
  log "pmset -g pslog ended; starting it again"
  sleep 1
done
